+/* =========================================================
+  석회석 입고량 · 사용량
+  1호기 / 2호기 비교표
+========================================================= */
+
+.efficiency-morning-meeting-auto-card.is-limestone
+  .efficiency-morning-meeting-limestone-quantity-table {
+  display: grid;
+
+  gap: 2px;
+
+  margin: 3px -1px 0;
+  padding: 3px;
+
+  border: 1px solid #e1eaf4;
+  border-radius: 7px;
+
+  background: #fbfdff;
+}
+
+
+.efficiency-morning-meeting-auto-card.is-limestone
+  .efficiency-morning-meeting-limestone-quantity-table__head,
+
+.efficiency-morning-meeting-auto-card.is-limestone
+  .efficiency-morning-meeting-limestone-quantity-table__row {
+  display: grid;
+
+  grid-template-columns:
+    minmax(48px, 0.78fr)
+    repeat(2, minmax(0, 1fr));
+
+  align-items: center;
+
+  gap: 3px;
+}
+
+
+.efficiency-morning-meeting-auto-card.is-limestone
+  .efficiency-morning-meeting-limestone-quantity-table__head {
+  min-height: 15px;
+}
+
+
+.efficiency-morning-meeting-auto-card.is-limestone
+  .efficiency-morning-meeting-limestone-quantity-table__head
+  > strong {
+  display: flex;
+
+  align-items: center;
+  justify-content: center;
+
+  min-width: 0;
+  min-height: 15px;
+
+  border-radius: 5px;
+
+  background: #eaf2fc;
+  color: #35649b;
+
+  font-size: 8px;
+  font-weight: 900;
+  line-height: 1;
+}
+
+
+.efficiency-morning-meeting-auto-card.is-limestone
+  .efficiency-morning-meeting-limestone-quantity-table__row {
+  min-height: 20px;
+}
+
+
+.efficiency-morning-meeting-auto-card.is-limestone
+  .efficiency-morning-meeting-limestone-quantity-table__row
+  > span {
+  min-width: 0;
+
+  padding-left: 3px;
+
+  color: #63758a;
+
+  font-size: 9px;
+  font-weight: 800;
+
+  white-space: nowrap;
+}
+
+
+.efficiency-morning-meeting-auto-card.is-limestone
+  .efficiency-morning-meeting-limestone-quantity-table__row
+  > strong {
+  display: flex;
+
+  align-items: center;
+  justify-content: center;
+
+  min-width: 0;
+  min-height: 20px;
+
+  padding: 0 3px;
+
+  border-radius: 5px;
+
+  background: #f4f7fb;
+  color: #213955;
+
+  font-size: 10px;
+  font-weight: 900;
+  line-height: 1;
+
+  text-align: center;
+  white-space: nowrap;
+}
+
+
+.efficiency-morning-meeting-auto-card.is-limestone
