+function getRecognitionEvidenceScore(
+  recognition
+) {
+  let score =
+    recognition.recognized
+      ? 100
+      : 0;
+
+
+  for (
+    const fieldName of [
+      "grossKg",
+      "tareKg",
+      "netKg"
+    ]
+  ) {
+    if (
+      recognition[fieldName] !==
+        null
+    ) {
+      score +=
+        10;
+    }
+  }
+
+
+  if (
+    recognition.recognitionSource ===
+      "validated_three_rows"
+  ) {
+    score +=
+      40;
+
+  } else if (
+    recognition.recognitionSource ===
+      "gross_minus_tare"
+  ) {
+    score +=
+      25;
+
+  } else if (
+    recognition.recognitionSource ===
+      "printed_net"
+  ) {
+    score +=
+      15;
+  }
+
+
+  if (
+    recognition.confidence ===
+      "high"
+  ) {
+    score +=
+      3;
+
+  } else if (
+    recognition.confidence ===
+      "medium"
+  ) {
+    score +=
+      2;
+  }
+
+
+  return score;
+}
